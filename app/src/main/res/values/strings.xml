    <string name="toast_app_selected">已选择：%1$s</string>

    <!-- Double-click interval -->
    <string name="section_interval">双击判定时间</string>
    <string name="hint_interval">两次按键间隔小于此值判定为双击。范围 100 ~ 2000 毫秒，默认 400ms。</string>
    <string name="hint_interval_input">400</string>
    <string name="unit_ms">ms</string>
    <string name="btn_save_interval">保存</string>
    <string name="btn_reset_interval">重置</string>
