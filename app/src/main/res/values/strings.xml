<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">音量键双击</string>
    <string name="accessibility_desc">拦截音量键，实现双击触发自定义动作（打开应用、执行Shell、切换铃声模式），单次点击正常调节音量。</string>
    <string name="title_pick_app">选择应用</string>

    <!-- MainActivity -->
    <string name="main_header">音量键双击动作设置</string>
    <string name="main_hint">本应用通过无障碍服务拦截音量键。单次点击正常调节音量，双击触发自定义动作。音量上、下分别独立设置。</string>

    <!-- Accessibility service status -->
    <string name="service_enabled">无障碍服务：已开启</string>
    <string name="service_enabled_hint">服务运行中，按键拦截已生效。</string>
    <string name="service_disabled">无障碍服务：未开启</string>
    <string name="service_disabled_hint">请点击下方按钮，在系统设置中开启本应用的无障碍服务，否则按键拦截不会生效。</string>
    <string name="btn_open_accessibility">去开启无障碍服务</string>
    <string name="btn_keep_alive">后台保活</string>
    <string name="section_vol_up">音量上 · 双击动作</string>
    <string name="section_vol_down">音量下 · 双击动作</string>
